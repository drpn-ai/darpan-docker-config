<?xml version="1.0" encoding="UTF-8"?>
<!--
  Production STDOUT JSON log configuration.
  Activated at runtime via: -Dlog4j2.configurationFile=/path/to/log4j2-json.xml
  Injected into JAVA_OPTS by the prod Dockerfile; local dev-stack.sh keeps the
  upstream PatternLayout (readable) by NOT setting log4j2.configurationFile.

  STDOUT emits one JSON object per line — compatible with docker logs, AWS CloudWatch,
  GCP Cloud Logging, and any structured-log aggregator. Rolling file appenders from
  the upstream config are retained so log rotation still works inside the container.

  MDC keys emitted (populated by DarpanMdcSupport.stamp per /rpc/json request):
    darpan.tenant        - active tenant userGroupId or "anonymous"
    darpan.userId        - authenticated userId or "anonymous"
    darpan.correlationId - per-request UUID (or X-Request-Id / X-Correlation-Id if provided)
-->
<Configuration status="ERROR" name="MoquiJson" shutdownHook="disable" packages="org.moqui.context">
    <Properties>
        <Property name="moqui.runtime">moqui_logs</Property>
        <Property name="moqui.logger.level.xml_action">info</Property>
        <Property name="moqui.logger.level.entity_find">info</Property>
        <Property name="moqui.logger.level.entity_query">info</Property>
        <Property name="log4j2.formatMsgNoLookups">true</Property>
    </Properties>

    <Appenders>
        <!-- Structured JSON to STDOUT — one object per line for docker logs / log shipper -->
        <Console name="STDOUT" target="SYSTEM_OUT">
            <JsonLayout compact="true" eventEol="true" objectMessageAsJsonObject="true"
                        includeTimeMillis="false" stacktraceAsString="true"
                        properties="true" propertiesAsList="false">
                <!--
                  JsonLayout includes the full MDC map as a "contextMap" object by default
                  when properties="true". The three darpan.* keys land there automatically.
                  Additional fixed fields: timeMillis→"instant", level, loggerName, thread,
                  message, thrown (with stackTrace when stacktraceAsString="true").
                -->
            </JsonLayout>
        </Console>

        <RollingFile name="LogFile" fileName="${sys:moqui.runtime}/log/moqui.log"
                filePattern="${sys:moqui.runtime}/log/moqui%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="--- %d{yyyy-MM-dd HH:mm:ss.SSS} [%15.15t] %-5p %50.50c %x%n %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/>
        </RollingFile>

        <RollingFile name="ErrorFile" fileName="${sys:moqui.runtime}/log/error.log"
                filePattern="${sys:moqui.runtime}/log/error%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="--- %d{yyyy-MM-dd HH:mm:ss.SSS} [%15.15t] %-5p %50.50c [%l] %x%n %m%n"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/>
        </RollingFile>

        <MoquiLog4jAppender name="MoquiSubscribers"/>

        <Async name="AsyncLog">
            <AppenderRef ref="STDOUT"/>
            <AppenderRef ref="LogFile"/>
            <AppenderRef ref="ErrorFile"/>
            <AppenderRef ref="MoquiSubscribers"/>
        </Async>
    </Appenders>

    <Loggers>
        <Logger name="org.apache" level="warn"/>
        <Logger name="org.eclipse.jetty.annotations" level="error"/>
        <Logger name="org.apache.fop.fo.extensions.svg.SVGElementMapping" level="fatal"/>
        <Logger name="freemarker" level="warn"/>
        <Logger name="org.elasticsearch" level="warn"/>
        <Logger name="org.drools" level="info"/>
        <Logger name="atomikos" level="warn"/>
        <Logger name="com.atomikos" level="warn"/>
        <Logger name="bitronix" level="warn"/>
        <Logger name="cz.vutbr" level="warn"/>
        <Logger name="org.moqui.impl.actions.XmlAction" level="${sys:moqui.logger.level.xml_action}"/>
        <Logger name="org.moqui.impl.entity.EntityFindBuilder" level="${sys:moqui.logger.level.entity_find}"/>
        <Logger name="org.moqui.impl.entity.EntityQueryBuilder" level="${sys:moqui.logger.level.entity_query}"/>
        <Logger name="org.moqui" level="info"/>
        <Root level="info"><AppenderRef ref="AsyncLog"/></Root>
    </Loggers>
</Configuration>
