# Local runtime env for compose.local.yml — NOT for production.
# Copy to .env.local (git-ignored) and fill in. Generate the two secrets ONCE and keep them:
#   entity_ds_crypt_pass="$(openssl rand -hex 32)"
#   JWT_KEY="$(openssl rand -hex 32)"
# Against a PERSISTENT database entity_ds_crypt_pass must never change (it decrypts stored
# secrets/tokens); a changed JWT_KEY invalidates all issued tokens.

# The image tag you built (e.g. darpan:local, or an ECR ref).
DARPAN_IMAGE=darpan:local

# Database (used by both the bundled postgres and the darpan service).
Moqui_DB_USER=moqui
Moqui_DB_PASSWORD=moqui
Moqui_DB_NAME=moqui

# Deployment-unique secrets — replace CHANGE_ME with `openssl rand -hex 32` output.
entity_ds_crypt_pass=CHANGE_ME
JWT_KEY=CHANGE_ME

# Optional.
Moqui_HOST=localhost
TIME_ZONE=UTC
Moqui_WEBAPP_ALLOW_ORIGINS=
DARPAN_LOAD_UPGRADE_DATA=Y
